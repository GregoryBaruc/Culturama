<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Culturama" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/culturama_background</item>
        <item name="android:statusBarColor">@color/culturama_background</item>
        <item name="android:navigationBarColor">@color/culturama_background</item>
        <item name="android:colorBackground">@color/culturama_background</item>
    </style>

    <!-- Splash do sistema sem ícone: só preto, a animação assume em seguida. -->
    <style name="Theme.Culturama.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/culturama_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/culturama_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Culturama</item>
    </style>

</resources>
