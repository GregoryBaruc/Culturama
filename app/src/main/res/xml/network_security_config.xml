<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Versão final: só HTTPS e só os certificados do sistema. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Só na versão de desenvolvimento, para testar em rede com inspeção de tráfego. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/fortinet_ca" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
